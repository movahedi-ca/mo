[Unit]
Description=MO Local Resource Assistant daemon
# The daemon binds only a Unix socket and probes localhost, so it
# does not wait on the network. default.target ordering is enough.
After=default.target
# DEFECT-005: StartLimitBurst and StartLimitIntervalSec are [Unit]
# directives. Under [Service] systemd ignored them and restart
# rate limiting was inactive.
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
ExecStart=%h/.local/bin/mo-daemon
Restart=on-failure
RestartSec=5
Environment=MO_DB_PATH=%h/jobs/mo/mo.db
Environment=MO_SOCKET_PATH=%h/jobs/mo/mo.sock
Environment=MO_LOCK_PATH=%h/jobs/mo/mo.lock
Environment=MO_DASHBOARD_PATH=%h/jobs/mo/dashboard.html
Environment=MO_HOST=chromebook-vm
# One daemon only: std File try_lock on MO_LOCK_PATH, error E11 on second start.
# Inventory snapshot every 60s and dashboard refresh every 30s run inside
# the daemon. No separate timer unit is needed for either.

[Install]
WantedBy=default.target
